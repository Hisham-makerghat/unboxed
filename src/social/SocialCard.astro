---
// The 1200×630 link-preview image (WhatsApp, LinkedIn, X), drawn with the page's own
// components. Only served by `astro dev` (see astro.config.mjs); `npm run social`
// screenshots it into public/og.png.
import { Font } from 'astro:assets';
import '../styles/global.css';
import LogoLockup from '../components/LogoLockup.astro';
import HeroArt from '../components/HeroArt.astro';
import { event } from '../content/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Social card</title>
    <Font cssVariable="--font-heading" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-display" />
  </head>
  <body>
    <div class="card">
      <div class="card__text">
        <LogoLockup tone="dark" size={56} />
        <div class="card__headline">
          <p class="card__eyebrow">{event.eyebrow}</p>
          <h1>{event.title}</h1>
        </div>
        <div class="card__when">
          <p class="card__date">{event.dateLong}</p>
          <p>
            {event.time} · {event.venue}
          </p>
        </div>
      </div>
      <HeroArt class="card__art" />
    </div>
  </body>
</html>

<style>
  .card {
    width: 1200px;
    height: 630px;
    display: flex;
    gap: 48px;
    padding: 56px;
    background: var(--purple);
    color: var(--white);
  }
  .card__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .card__headline {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .card__eyebrow {
    padding: 8px 18px;
    border: 2px solid var(--yellow);
    border-radius: var(--radius-pill);
    color: var(--yellow);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    font-weight: 700;
    font-size: 72px;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .card__when {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 20px;
    border-top: 2px dashed rgba(255, 255, 255, 0.35);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 24px;
  }
  .card__date {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 34px;
    line-height: 1.1;
    color: var(--yellow);
  }
  .card :global(.card__art) {
    width: 440px;
    flex: none;
    border-radius: 28px;
  }
  /* A still picture: everything in its final place */
  .card :global(*) {
    animation: none !important;
  }
</style>
