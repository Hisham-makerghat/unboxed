---
import { Image } from 'astro:assets';
import UnboxedMark from './UnboxedMark.astro';
import triangles from '../assets/art/triangles-green.svg';
import hexagons from '../assets/art/hexagons-coral.svg';
import sparkle from '../assets/art/sparkle-green.svg';
import { cta, links } from '../content/site';
---

<section class="cta" aria-labelledby="cta-title">
  <Image src={triangles} alt="" class="cta__deco cta__deco--triangles" />
  <Image src={hexagons} alt="" class="cta__deco cta__deco--hexagons" />
  <Image src={sparkle} alt="" class="cta__deco cta__deco--sparkle" />
  <div class="cta__inner container">
    <UnboxedMark size="clamp(34px, 4.4vw, 64px)" backing="var(--white)" class="cta__mark" />
    <h2 id="cta-title">{cta.title}</h2>
    <a
      class="button button--purple button--large cta__button"
      href={links.register}
      data-track="footer-cta"
    >
      {cta.button}
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14"></path>
        <path d="M13 6l6 6-6 6"></path>
      </svg>
    </a>
    <p class="cta__questions">
      {cta.questions} <a href={`mailto:${links.questionsEmail}`}>{links.questionsEmail}</a>
    </p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--yellow);
    padding-block: 56px;
  }
  .cta :global(.cta__deco) {
    position: absolute;
    height: auto;
  }
  .cta :global(.cta__deco--triangles) {
    left: 18px;
    top: 24px;
    width: 62px;
  }
  .cta :global(.cta__deco--hexagons) {
    display: none;
  }
  .cta :global(.cta__deco--sparkle) {
    right: 18px;
    top: 18px;
    width: 44px;
  }
  .cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 900px;
    text-align: center;
  }
  .cta__inner :global(.cta__mark) {
    margin-top: 16px;
  }
  h2 {
    font-weight: 700;
    font-size: clamp(30px, 4.4vw, 64px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--purple-ink);
  }
  .cta__button {
    align-self: stretch;
  }
  .cta__questions {
    font-size: 15px;
    color: var(--olive);
  }
  .cta__questions a {
    color: var(--purple-ink);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  @media (min-width: 720px) {
    .cta {
      padding-block: clamp(64px, 8vw, 112px);
    }
    .cta :global(.cta__deco--triangles) {
      left: 8%;
      top: 56px;
      width: 100px;
    }
    .cta :global(.cta__deco--hexagons) {
      display: block;
      right: 9%;
      bottom: 64px;
      width: 110px;
    }
    .cta :global(.cta__deco--sparkle) {
      right: 12%;
      top: 48px;
      width: 64px;
    }
    .cta__inner {
      gap: 26px;
    }
    .cta__inner :global(.cta__mark) {
      margin-top: 0;
    }
    .cta__button {
      align-self: center;
      min-height: 58px;
      padding: 0 36px;
    }
    .cta__questions {
      font-size: 17px;
    }
  }
</style>
