---
// The first screen: a closed kraft box printed with a traditional classroom.
// Opening it breaks the front into four pieces, folds the flaps back and lifts the
// UNBOXED mark out; then the event details underneath fade in.
// State lives on <html data-intro="closed | breaking | open">, set by Layout's head
// script and by scripts/unbox.ts. Without JavaScript this screen never shows.
import { Image } from 'astro:assets';
import LogoLockup from './LogoLockup.astro';
import UnboxedMark from './UnboxedMark.astro';
import classroom from '../assets/art/classroom-silhouette.svg';
import hand from '../assets/brand/hand-purple.svg';
import { event, intro } from '../content/site';

// The front face is cut into four shards along the same lines
const shards = [
  'polygon(0 0, 55% 0, 42% 48%, 0 60%)',
  'polygon(55% 0, 100% 0, 100% 52%, 42% 48%)',
  'polygon(0 60%, 42% 48%, 58% 100%, 0 100%)',
  'polygon(42% 48%, 100% 52%, 100% 100%, 58% 100%)',
];
---

<div class="intro" id="intro" aria-label="UNBOXED intro">
  <LogoLockup tone="light" size={54} sizeSmall={40} class="intro__logos" />

  <div class="intro__middle">
    <p class="intro__eyebrow">{event.eyebrow}</p>
    <p class="intro__title">{intro.title}</p>
    <button type="button" class="scene" data-unbox aria-label={intro.boxLabel}>
      <span class="box">
        <span class="face face--back"></span>
        <span class="face face--bottom"></span>
        <span class="face face--left"></span>
        <span class="box__mark">
          <UnboxedMark size="calc(44 * var(--u))" tilted={false} />
        </span>
        <span class="face face--right">
          <svg class="arrows" viewBox="0 0 64 40" aria-hidden="true">
            <g
              fill="none"
              stroke="currentColor"
              stroke-width="5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 36V8M8 18 18 6l10 12"></path>
              <path d="M46 36V8M36 18 46 6l10 12"></path>
            </g>
          </svg>
          <Image src={hand} alt="" class="face__hand" />
        </span>
        <span class="lid">
          <span class="flap flap--back"></span>
          <span class="flap flap--front"></span>
        </span>
        <span class="face face--front">
          <Image src={classroom} alt={intro.classroomAlt} class="shard__art" />
        </span>
        {shards.map((clip, i) => (
          <span class={`shard shard--${i + 1}`} style={`clip-path: ${clip};`}>
            <Image src={classroom} alt="" class="shard__art" />
          </span>
        ))}
      </span>
      <span class="scene__shadow" aria-hidden="true"></span>
    </button>
  </div>

  <div class="intro__bottom">
    <div class="intro__actions">
      <button type="button" class="button button--purple intro__open" data-unbox>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10"></path>
          <path d="M12 10V9a1.5 1.5 0 0 1 3 0v2"></path>
          <path d="M15 11a1.5 1.5 0 0 1 3 0v3a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7l-2.2-3.6a1.5 1.5 0 0 1 2.5-1.6L9 14"></path>
        </svg>
        <span class="label-pointer">{intro.click}</span>
        <span class="label-touch">{intro.tap}</span>
      </button>
    </div>
    <p class="intro__facts">
      <span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="16" rx="2"></rect>
          <path d="M16 3v4M8 3v4M3 10h18"></path>
        </svg>
        {event.dateShort} · {event.day} · {event.time}
      </span>
      <span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path>
          <circle cx="12" cy="10" r="2.5"></circle>
        </svg>
        {event.venue}
      </span>
    </p>
  </div>
</div>

<style>
  /* ---------- Layout: exactly one screen ---------- */
  .intro {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: none;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px 20px 24px;
    overflow: hidden;
    background: var(--ivory);
    color: var(--purple-ink);
  }
  :global(:root[data-intro='closed']) .intro,
  :global(:root[data-intro='breaking']) .intro {
    display: flex;
  }
  :global(:root[data-intro='breaking']) .intro {
    opacity: 0;
    pointer-events: none;
    transition: opacity 600ms ease 900ms;
  }
  @media (min-width: 720px) {
    .intro {
      padding: 24px clamp(16px, 3.4vw, 48px) 32px;
    }
  }
  .intro :global(.intro__logos) {
    align-self: flex-start;
  }
  .intro__middle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  .intro__eyebrow {
    color: var(--kraft-dark);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .intro__title {
    margin-top: 4px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  @media (min-width: 720px) {
    .intro__eyebrow {
      font-size: 14px;
    }
  }
  .intro__bottom {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
  }
  .intro__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
  }
  .intro__facts {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 2px dashed var(--kraft-light);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--kraft-dark);
    font-size: 14px;
    font-weight: 500;
  }
  .intro__facts span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  @media (min-width: 720px) {
    .intro__bottom {
      align-items: center;
      gap: 14px;
    }
    .intro__actions {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 12px 24px;
    }
    .intro__facts {
      margin-top: 0;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px 24px;
      padding-top: 14px;
      font-size: 15px;
    }
  }

  /* "Tap" on touch screens, "Click" elsewhere */
  .label-touch {
    display: none;
  }
  @media (hover: none) and (pointer: coarse) {
    .label-pointer {
      display: none;
    }
    .label-touch {
      display: inline;
    }
  }

  /* ---------- The 3D box ----------
     Every length is a multiple of --u, so one set of numbers serves every screen. */
  .intro {
    --s: 0.74;
    --u: calc(var(--s) * 1px);
  }
  @media (max-height: 700px) {
    .intro {
      --s: 0.62;
    }
  }
  @media (max-height: 600px) {
    .intro {
      --s: 0.5;
    }
  }
  @media (min-width: 720px) {
    .intro {
      --s: 1;
    }
  }
  @media (min-width: 720px) and (max-height: 860px) {
    .intro {
      --s: 0.86;
    }
  }
  @media (min-width: 720px) and (max-height: 740px) {
    .intro {
      --s: 0.72;
    }
  }
  @media (min-width: 720px) and (max-height: 640px) {
    .intro {
      --s: 0.58;
    }
  }

  .scene {
    display: block;
    width: calc(520 * var(--u));
    max-width: 100%;
    height: calc(400 * var(--u));
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    perspective: calc(1400 * var(--u));
    perspective-origin: 50% 30%;
    border-radius: 24px;
  }
  .box {
    position: relative;
    display: block;
    width: calc(380 * var(--u));
    height: calc(270 * var(--u));
    margin: calc(70 * var(--u)) auto 0;
    transform-style: preserve-3d;
    transform: rotateX(-16deg) rotateY(-28deg);
    transition: transform 400ms ease;
  }
  .scene:hover .box {
    transform: rotateX(-16deg) rotateY(-22deg);
  }
  .face,
  .lid,
  .flap,
  .shard,
  .box__mark {
    position: absolute;
    display: block;
  }
  .face--back {
    left: 0;
    top: 0;
    width: calc(380 * var(--u));
    height: calc(270 * var(--u));
    background: var(--kraft-mid);
    transform: translateZ(calc(-110 * var(--u)));
  }
  .face--bottom {
    left: 0;
    top: calc(25 * var(--u));
    width: calc(380 * var(--u));
    height: calc(220 * var(--u));
    background: var(--kraft-dark);
    transform: rotateX(-90deg) translateZ(calc(135 * var(--u)));
  }
  .face--left,
  .face--right {
    left: calc(80 * var(--u));
    top: 0;
    width: calc(220 * var(--u));
    height: calc(270 * var(--u));
  }
  .face--left {
    background: var(--kraft-side);
    transform: rotateY(-90deg) translateZ(calc(190 * var(--u)));
  }
  .face--right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(14 * var(--u));
    background: var(--kraft);
    color: var(--kraft-ink);
    transform: rotateY(90deg) translateZ(calc(190 * var(--u)));
    transition:
      transform 1000ms cubic-bezier(0.2, 0.75, 0.25, 1),
      opacity 500ms ease 300ms;
  }
  .arrows {
    width: calc(64 * var(--u));
    height: calc(40 * var(--u));
  }
  .face--right :global(.face__hand) {
    width: calc(46 * var(--u));
  }
  .lid {
    left: 0;
    top: calc(25 * var(--u));
    width: calc(380 * var(--u));
    height: calc(220 * var(--u));
    transform-style: preserve-3d;
    transform: rotateX(90deg) translateZ(calc(135 * var(--u)));
  }
  .flap {
    left: 0;
    width: calc(380 * var(--u));
    height: calc(110 * var(--u));
    background: var(--kraft-flap);
    transition: transform 800ms cubic-bezier(0.3, 0.7, 0.3, 1);
  }
  .flap::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: calc(12 * var(--u));
    background: var(--kraft-tape);
  }
  .flap--back {
    top: 0;
    transform-origin: 50% 0%;
  }
  .flap--back::after {
    bottom: 0;
  }
  .flap--front {
    top: calc(110 * var(--u));
    transform-origin: 50% 100%;
  }
  .flap--front::after {
    top: 0;
  }
  .shard {
    left: 0;
    top: 0;
    width: calc(380 * var(--u));
    height: calc(270 * var(--u));
    background: var(--kraft-light);
    transform: translateZ(calc(110 * var(--u)));
    transition:
      transform 1000ms cubic-bezier(0.2, 0.75, 0.25, 1),
      opacity 500ms ease 450ms;
  }
  /* An uncut copy of the front sits just behind the four pieces, so the hairline seams
     between them show the same picture instead of the dark inside of the box.
     It disappears the moment the box starts breaking. */
  .face--front {
    left: 0;
    top: 0;
    width: calc(380 * var(--u));
    height: calc(270 * var(--u));
    background: var(--kraft-light);
    transform: translateZ(calc(109 * var(--u)));
  }
  :global(:root[data-intro='breaking']) .face--front {
    visibility: hidden;
  }
  .shard :global(.shard__art),
  .face--front :global(.shard__art) {
    position: absolute;
    left: calc(12 * var(--u));
    top: calc(12 * var(--u));
    width: calc(356 * var(--u));
    height: calc(246 * var(--u));
    object-fit: cover;
    border-radius: 4px;
  }
  .box__mark {
    left: 50%;
    top: 50%;
    opacity: 0;
    transform: translate(-50%, -50%) translateY(calc(40 * var(--u))) scale(0.6);
    transition:
      transform 1000ms cubic-bezier(0.2, 0.8, 0.2, 1) 200ms,
      opacity 400ms ease 200ms;
  }
  .scene__shadow {
    display: block;
    width: calc(360 * var(--u));
    height: calc(26 * var(--u));
    margin: calc(34 * var(--u)) auto 0;
    border-radius: 50%;
    background: var(--kraft-rule);
  }

  /* ---------- Breaking open ---------- */
  :global(:root[data-intro='breaking']) .flap--back {
    transform: rotateX(118deg);
  }
  :global(:root[data-intro='breaking']) .flap--front {
    transform: rotateX(-172deg);
  }
  :global(:root[data-intro='breaking']) .face--right {
    opacity: 0;
    transform: rotateY(90deg) translateZ(calc(320 * var(--u))) translateY(calc(70 * var(--u)))
      rotateX(-18deg);
  }
  :global(:root[data-intro='breaking']) .box__mark {
    opacity: 1;
    transform: translate(-50%, -50%) translateZ(calc(60 * var(--u)))
      translateY(calc(-150 * var(--u))) scale(1.15);
  }
  :global(:root[data-intro='breaking']) .shard {
    opacity: 0;
  }
  :global(:root[data-intro='breaking']) .shard--1 {
    transform: translateZ(calc(110 * var(--u)))
      translate3d(calc(-190 * var(--u)), calc(-130 * var(--u)), calc(160 * var(--u)))
      rotateZ(-28deg) rotateX(24deg);
  }
  :global(:root[data-intro='breaking']) .shard--2 {
    transform: translateZ(calc(110 * var(--u)))
      translate3d(calc(190 * var(--u)), calc(-140 * var(--u)), calc(140 * var(--u))) rotateZ(26deg)
      rotateY(-28deg);
  }
  :global(:root[data-intro='breaking']) .shard--3 {
    transform: translateZ(calc(110 * var(--u)))
      translate3d(calc(-170 * var(--u)), calc(150 * var(--u)), calc(170 * var(--u))) rotateZ(20deg)
      rotateX(-26deg);
  }
  :global(:root[data-intro='breaking']) .shard--4 {
    transform: translateZ(calc(110 * var(--u)))
      translate3d(calc(180 * var(--u)), calc(160 * var(--u)), calc(150 * var(--u))) rotateZ(-24deg)
      rotateY(28deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .box,
    .face--right,
    .flap,
    .shard,
    .box__mark {
      transition: none;
    }
  }
</style>
