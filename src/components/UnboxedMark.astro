---
// The official UNBOXED logo. Its UNBOX letters are cut out of the purple face, so they
// take the colour of whatever is behind them, as designed. `backing` fills them with one
// colour instead, for places where what's behind isn't flat (the box, the hero's trails).
// Other versions in assets/brand: unboxed-logo-reverse.png (white face, for purple
// backgrounds) and unboxed-logo-white.png (all white).
import logo from '../assets/brand/unboxed-logo.png';

interface Props {
  /** Any CSS font-size value; the logo is 4.8 times this wide */
  size: string;
  /** A CSS colour to show through the letters instead of what is behind the logo */
  backing?: string;
  class?: string;
}
const { size, backing, class: className } = Astro.props;
---

<span
  class:list={['mark', { 'mark--backed': backing }, className]}
  style={`--mark-size: ${size};${backing ? ` --mark-backing: ${backing};` : ''}`}
>
  {/* The original file (701 px, 9 KB) is already sharp and small; re-encoding only grows it */}
  <img
    src={logo.src}
    width={logo.width}
    height={logo.height}
    alt="UNBOXED"
    decoding="async"
    class="mark__img"
  />
</span>

<style>
  .mark {
    position: relative;
    display: block;
    width: 4.8em;
    max-width: 100%;
    font-size: var(--mark-size);
    line-height: 0;
  }
  .mark :global(.mark__img) {
    position: relative;
    width: 100%;
    height: auto;
  }
  /* The backing colour exactly behind the purple face (its corners, measured from the logo file) */
  .mark--backed::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--mark-backing);
    clip-path: polygon(0.14% 19.57%, 72.04% 0.43%, 72.04% 99.15%, 0.14% 79.57%);
  }
</style>
