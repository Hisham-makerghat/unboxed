---
import LogoLockup from './LogoLockup.astro';
import { footer, links } from '../content/site';
---

<footer class="site-footer on-dark">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <LogoLockup tone="dark" size={54} sizeSmall={46} />
      <p>
        {footer.licence} <span class="nowrap">{footer.licenceName}</span>
      </p>
    </div>
    <ul class="site-footer__socials">
      {links.socials.map((s) => (
        <li>
          <a href={s.href} aria-label={`MakerGhat on ${s.label}`} rel="noopener">
            {s.icon === 'instagram' && (
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
              </svg>
            )}
            {s.icon === 'youtube' && (
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M9 7.5v9l7.5-4.5z" />
              </svg>
            )}
            {s.icon === 'linkedin' && (
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <rect x="4" y="9" width="3.2" height="11" />
                <circle cx="5.6" cy="5.6" r="1.9" />
                <path d="M10 9h3v1.6c.6-1 1.8-1.8 3.4-1.8 2.6 0 3.6 1.6 3.6 4.4V20h-3.2v-6.1c0-1.4-.5-2.3-1.7-2.3-1.3 0-1.9.9-1.9 2.3V20H10z" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    flex-grow: 1;
    background: var(--purple);
    color: var(--white);
    padding: 32px 0 36px;
  }
  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-inline: 20px;
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .site-footer__brand p {
    font-size: 14px;
    color: var(--purple-tint);
  }
  .nowrap {
    white-space: nowrap;
  }
  .site-footer__socials {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__socials a {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--white);
    color: var(--purple);
  }
  @media (min-width: 720px) {
    .site-footer {
      padding-block: 40px;
    }
    .site-footer__inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding-inline: var(--gutter);
    }
    .site-footer__brand {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 28px;
    }
    .site-footer__brand p {
      font-size: 15px;
    }
  }
</style>
