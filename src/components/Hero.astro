---
// First screen: the event details (header, headline, open box, ticket) with the
// unboxing intro laid over them until the visitor opens the box.
import { Image } from 'astro:assets';
import IntroBox from './IntroBox.astro';
import LogoLockup from './LogoLockup.astro';
import UnboxedMark from './UnboxedMark.astro';
import sparkle from '../assets/art/sparkle-coral.svg';
import leds from '../assets/art/el-leds.png';
import clips from '../assets/art/el-clips.png';
import hand from '../assets/brand/hand-purple.svg';
import { event, hero, links } from '../content/site';
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__content" id="hero-content">
    <header class="site-header">
      <LogoLockup tone="dark" size={54} sizeSmall={38} />
      <div class="site-header__end">
        <span class="site-header__when">
          {event.dateShort} · {event.venueShort}
        </span>
        <a
          class="button button--yellow site-header__register"
          href={links.register}
          data-track="header"
        >
          Register
        </a>
      </div>
    </header>

    <div class="hero__main container">
      <div class="hero__grid">
        <p class="hero__eyebrow">{event.eyebrow}</p>
        <h1 class="hero__title" id="hero-title" tabindex="-1">
          {event.title}
        </h1>
        <div class="hero__actions">
          <a
            class="button button--yellow button--large hero__register"
            href={links.register}
            data-track="hero"
          >
            {hero.register}
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a class="hero__explore" href="#journey">
            {hero.explore}
          </a>
        </div>
        <div class="hero__art" aria-hidden="true">
          <Image src={sparkle} alt="" class="hero__deco hero__deco--sparkle" />
          <Image
            src={leds}
            alt=""
            width={46}
            densities={[1, 2]}
            class="hero__deco hero__deco--leds"
          />
          <Image
            src={clips}
            alt=""
            width={70}
            densities={[1, 2]}
            class="hero__deco hero__deco--clips"
          />
          <div class="open-box">
            <span class="open-box__flap open-box__flap--left"></span>
            <span class="open-box__flap open-box__flap--right"></span>
            <div class="open-box__mark">
              <UnboxedMark size="calc(56px * var(--k))" />
            </div>
            <div class="open-box__front">
              <svg class="open-box__arrows" viewBox="0 0 64 40">
                <g
                  fill="none"
                  stroke="currentColor"
                  stroke-width="5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M18 36V8M8 18 18 6l10 12"></path>
                  <path d="M46 36V8M36 18 46 6l10 12"></path>
                </g>
              </svg>
              <Image src={hand} alt="" class="open-box__hand" />
            </div>
          </div>
        </div>
      </div>

      <dl class="ticket">
        <div class="ticket__cell ticket__cell--date">
          <dt>Date</dt>
          <dd>
            <span class="ticket__date">{event.dateShort}</span>
            <span class="ticket__day">{event.day}</span>
          </dd>
        </div>
        <div class="ticket__cell ticket__cell--time">
          <dt>Time</dt>
          <dd class="ticket__strong">{event.time}</dd>
        </div>
        <div class="ticket__cell ticket__cell--venue">
          <dt>Venue</dt>
          <dd class="ticket__strong">{event.venue}</dd>
        </div>
      </dl>
    </div>
  </div>
  <script is:inline>
    // Keep the details out of the keyboard order while the intro covers them
    if (document.documentElement.dataset.intro === 'closed')
      document.getElementById('hero-content').inert = true;
  </script>
  <IntroBox />
</section>

<script>
  import '../scripts/unbox';
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--purple);
    color: var(--white);
  }
  /* While the intro shows, the section is exactly one screen tall */
  :global(:root[data-intro='closed']) .hero,
  :global(:root[data-intro='breaking']) .hero {
    height: 100vh;
    height: 100svh;
  }
  .hero__content {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  :global(:root[data-intro='closed']) .hero__content {
    opacity: 0;
    transform: translateY(28px);
  }
  :global(:root[data-intro='breaking']) .hero__content {
    transition:
      opacity 700ms ease 1000ms,
      transform 700ms ease 1000ms;
  }

  /* ---------- Header ---------- */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
  }
  .site-header__end {
    display: flex;
    align-items: center;
    gap: 12px 24px;
  }
  .site-header__when {
    display: none;
    color: var(--purple-tint);
    font-weight: 500;
  }
  .site-header__register {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
  }
  @media (min-width: 720px) {
    .site-header {
      padding: 24px clamp(16px, 3.4vw, 48px);
    }
    .site-header__when {
      display: inline;
    }
    .site-header__register {
      min-height: 46px;
      padding: 0 24px;
      font-size: 17px;
    }
  }

  /* ---------- Headline and open box ---------- */
  .hero__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding-top: 8px;
    padding-bottom: 56px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'eyebrow' 'art' 'title' 'actions';
    gap: 18px;
  }
  .hero__eyebrow {
    grid-area: eyebrow;
    justify-self: start;
    padding: 6px 14px;
    border: 1.5px solid var(--yellow);
    border-radius: var(--radius-pill);
    color: var(--yellow);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero__title {
    grid-area: title;
    font-weight: 700;
    font-size: clamp(36px, 5.6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .hero__title:focus {
    outline: none;
  }
  .hero__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .hero__register {
    flex: 1 1 100%;
  }
  .hero__explore {
    display: none;
    color: var(--white);
    font-weight: 500;
    text-underline-offset: 5px;
  }
  @media (min-width: 720px) {
    .hero__main {
      gap: 40px;
      padding-top: 16px;
      padding-bottom: clamp(64px, 7vw, 96px);
    }
    .hero__grid {
      grid-template-areas: 'eyebrow' 'title' 'actions' 'art';
      gap: 22px;
    }
    .hero__eyebrow {
      padding: 8px 18px;
      font-size: 14px;
    }
    .hero__actions {
      padding-top: 8px;
    }
    .hero__register {
      flex: none;
    }
    .hero__explore {
      display: inline;
    }
  }
  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto auto auto 1fr;
      grid-template-areas: '. art' 'eyebrow art' 'title art' 'actions art' '. art';
      column-gap: 64px;
    }
  }

  .hero__art {
    --k: 0.7;
    grid-area: art;
    position: relative;
    overflow: hidden;
    min-height: 220px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 24px 16px 0;
    border-radius: 22px;
    background: var(--ivory);
  }
  @media (min-width: 720px) {
    .hero__art {
      --k: 1;
      min-height: 400px;
      padding: 40px 24px 0;
      border-radius: 28px;
    }
  }
  .hero__art :global(.hero__deco) {
    position: absolute;
    height: auto;
  }
  .hero__art :global(.hero__deco--sparkle) {
    top: calc(26px * var(--k));
    right: calc(44px * var(--k));
    width: calc(46px * var(--k));
  }
  .hero__art :global(.hero__deco--leds) {
    top: calc(44px * var(--k));
    left: calc(52px * var(--k));
    width: calc(46px * var(--k));
    transform: rotate(-16deg);
  }
  .hero__art :global(.hero__deco--clips) {
    top: calc(24px * var(--k));
    left: 44%;
    width: calc(70px * var(--k));
  }
  .open-box {
    position: relative;
    width: calc(380px * var(--k));
    max-width: 100%;
    height: calc(260px * var(--k));
  }
  .open-box__flap {
    position: absolute;
    top: calc(128px * var(--k));
    width: calc(160px * var(--k));
    height: calc(46px * var(--k));
    background: var(--kraft);
    border-radius: 4px 4px 0 0;
  }
  .open-box__flap--left {
    left: calc(10px * var(--k));
    transform: rotate(-14deg);
    transform-origin: 100% 100%;
  }
  .open-box__flap--right {
    right: calc(10px * var(--k));
    transform: rotate(14deg);
    transform-origin: 0% 100%;
  }
  .open-box__mark {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(96px * var(--k));
    z-index: 1;
    display: flex;
    justify-content: center;
  }
  .open-box__front {
    position: absolute;
    left: calc(34px * var(--k));
    right: calc(34px * var(--k));
    bottom: 0;
    z-index: 2;
    height: calc(112px * var(--k));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(22px * var(--k));
    border-radius: 6px 6px 0 0;
    background: var(--kraft-light);
    color: var(--kraft-ink);
  }
  .open-box__arrows {
    width: calc(52px * var(--k));
    height: calc(34px * var(--k));
  }
  .open-box__front :global(.open-box__hand) {
    width: calc(40px * var(--k));
  }

  /* ---------- Ticket ---------- */
  .ticket {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border-radius: 20px;
    background: var(--ivory);
    color: var(--purple-ink);
  }
  .ticket__cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 18px;
  }
  .ticket__cell--time {
    border-left: 2px dashed var(--kraft-light);
  }
  .ticket__cell--venue {
    grid-column: 1 / -1;
    border-top: 2px dashed var(--kraft-light);
    padding-top: 14px;
  }
  .ticket dt {
    color: var(--kraft-dark);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ticket dd {
    margin: 0;
  }
  .ticket__date {
    display: block;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.15;
    color: var(--purple);
  }
  .ticket__day {
    display: block;
    font-size: 15px;
  }
  .ticket__strong {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
  }
  .ticket__cell--venue .ticket__strong {
    font-size: 18px;
    line-height: 1.3;
  }
  @media (min-width: 720px) {
    .ticket {
      display: flex;
      flex-wrap: wrap;
      border-radius: 22px;
    }
    .ticket__cell {
      padding: 20px 28px;
    }
    .ticket__cell--date {
      flex: 1 1 200px;
    }
    .ticket__cell--time {
      flex: 1 1 180px;
    }
    .ticket__cell--venue {
      flex: 1.6 1 260px;
      border-top: 0;
      padding-top: 20px;
      border-left: 2px dashed var(--kraft-light);
    }
    .ticket dt {
      font-size: 13px;
    }
    .ticket__date {
      font-size: 26px;
    }
    .ticket__day {
      font-size: 16px;
    }
    .ticket__strong {
      font-size: 24px;
    }
    .ticket__cell--venue .ticket__strong {
      font-size: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(:root[data-intro='breaking']) .hero__content {
      transition: none;
    }
  }
</style>
