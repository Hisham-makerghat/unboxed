---
// First screen: the event details (header, headline, open box, ticket) with the
// unboxing intro laid over them until the visitor opens the box.
import IntroBox from './IntroBox.astro';
import LogoLockup from './LogoLockup.astro';
import HeroArt from './HeroArt.astro';
import { event, hero, links } from '../content/site';
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__content" id="hero-content">
    <header class="site-header">
      <LogoLockup tone="dark" size={54} sizeSmall={38} />
      <div class="site-header__end">
        <span class="site-header__when">
          {event.dateShort} · {event.venueShort}
        </span>
        <a
          class="button button--yellow site-header__register"
          href={links.register}
          data-track="header"
        >
          Register
        </a>
      </div>
    </header>

    <div class="hero__main container">
      <div class="hero__grid">
        <p class="hero__eyebrow">{event.eyebrow}</p>
        <h1 class="hero__title" id="hero-title" tabindex="-1">
          {event.title}
        </h1>
        <div class="hero__actions">
          <a
            class="button button--yellow button--large hero__register"
            href={links.register}
            data-track="hero"
          >
            {hero.register}
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a class="hero__explore" href="#journey">
            {hero.explore}
          </a>
        </div>
        <HeroArt class="hero__art" />
      </div>

      <dl class="ticket">
        <div class="ticket__cell ticket__cell--date">
          <dt>Date</dt>
          <dd>
            <span class="ticket__date">{event.dateShort}</span>
            <span class="ticket__day">{event.day}</span>
          </dd>
        </div>
        <div class="ticket__cell ticket__cell--time">
          <dt>Time</dt>
          <dd class="ticket__strong">{event.time}</dd>
        </div>
        <div class="ticket__cell ticket__cell--venue">
          <dt>Venue</dt>
          <dd class="ticket__strong">{event.venue}</dd>
        </div>
      </dl>
    </div>
  </div>
  <script is:inline>
    // Keep the details out of the keyboard order while the intro covers them
    if (document.documentElement.dataset.intro === 'closed')
      document.getElementById('hero-content').inert = true;
  </script>
  <IntroBox />
</section>

<script>
  import '../scripts/unbox';
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--purple);
    color: var(--white);
  }
  /* While the intro shows, the section is exactly one screen tall */
  :global(:root[data-intro='closed']) .hero,
  :global(:root[data-intro='breaking']) .hero {
    height: 100vh;
    height: 100svh;
  }
  .hero__content {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  :global(:root[data-intro='closed']) .hero__content {
    opacity: 0;
    transform: translateY(28px);
  }
  :global(:root[data-intro='breaking']) .hero__content {
    transition:
      opacity 700ms ease 1000ms,
      transform 700ms ease 1000ms;
  }

  /* ---------- Header ---------- */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
  }
  .site-header__end {
    display: flex;
    align-items: center;
    gap: 12px 24px;
  }
  .site-header__when {
    display: none;
    color: var(--purple-tint);
    font-weight: 500;
  }
  .site-header__register {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
  }
  @media (min-width: 720px) {
    .site-header {
      padding: 24px clamp(16px, 3.4vw, 48px);
    }
    .site-header__when {
      display: inline;
    }
    .site-header__register {
      min-height: 46px;
      padding: 0 24px;
      font-size: 17px;
    }
  }

  /* ---------- Headline and open box ---------- */
  .hero__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding-top: 8px;
    padding-bottom: 56px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'eyebrow' 'art' 'title' 'actions';
    gap: 18px;
  }
  .hero__eyebrow {
    grid-area: eyebrow;
    justify-self: start;
    padding: 6px 12px;
    border: 1.5px solid var(--yellow);
    /* Rounded rather than a pill, so it still looks right if it wraps on a narrow phone */
    border-radius: 16px;
    color: var(--yellow);
    font-weight: 600;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .hero__title {
    grid-area: title;
    font-weight: 700;
    font-size: clamp(36px, 5.6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .hero__title:focus {
    outline: none;
  }
  .hero__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .hero__register {
    flex: 1 1 100%;
  }
  .hero__explore {
    display: none;
    color: var(--white);
    font-weight: 500;
    text-underline-offset: 5px;
  }
  @media (min-width: 720px) {
    .hero__main {
      gap: 40px;
      padding-top: 16px;
      padding-bottom: clamp(64px, 7vw, 96px);
    }
    .hero__grid {
      grid-template-areas: 'eyebrow' 'title' 'actions' 'art';
      gap: 22px;
    }
    .hero__eyebrow {
      padding: 8px 18px;
      border-radius: var(--radius-pill);
      font-size: 14px;
      letter-spacing: 0.08em;
    }
    .hero__actions {
      padding-top: 8px;
    }
    .hero__register {
      flex: none;
    }
    .hero__explore {
      display: inline;
    }
  }
  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto auto auto 1fr;
      grid-template-areas: '. art' 'eyebrow art' 'title art' 'actions art' '. art';
      column-gap: 64px;
    }
  }

  .hero__grid :global(.hero__art) {
    grid-area: art;
    height: 300px;
    border-radius: 22px;
  }
  @media (min-width: 720px) {
    .hero__grid :global(.hero__art) {
      height: 420px;
      border-radius: 28px;
    }
  }
  @media (min-width: 1000px) {
    .hero__grid :global(.hero__art) {
      height: auto;
      min-height: 420px;
    }
  }

  /* ---------- Ticket ---------- */
  .ticket {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border-radius: 20px;
    background: var(--ivory);
    color: var(--purple-ink);
  }
  .ticket__cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 18px;
  }
  .ticket__cell--time {
    border-left: 2px dashed var(--kraft-light);
  }
  .ticket__cell--venue {
    grid-column: 1 / -1;
    border-top: 2px dashed var(--kraft-light);
    padding-top: 14px;
  }
  .ticket dt {
    color: var(--kraft-dark);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ticket dd {
    margin: 0;
  }
  .ticket__date {
    display: block;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.15;
    color: var(--purple);
  }
  .ticket__day {
    display: block;
    font-size: 15px;
  }
  .ticket__strong {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
  }
  .ticket__date,
  .ticket__cell--time .ticket__strong {
    white-space: nowrap;
  }
  .ticket__cell--venue .ticket__strong {
    font-size: 18px;
    line-height: 1.3;
  }
  @media (min-width: 720px) {
    .ticket {
      display: flex;
      flex-wrap: wrap;
      border-radius: 22px;
    }
    .ticket__cell {
      padding: 20px 28px;
    }
    .ticket__cell--date {
      flex: 1 1 200px;
    }
    .ticket__cell--time {
      flex: 1 1 180px;
    }
    .ticket__cell--venue {
      flex: 1.6 1 260px;
      border-top: 0;
      padding-top: 20px;
      border-left: 2px dashed var(--kraft-light);
    }
    .ticket dt {
      font-size: 13px;
    }
    .ticket__date {
      font-size: 26px;
    }
    .ticket__day {
      font-size: 16px;
    }
    .ticket__strong {
      font-size: 24px;
    }
    .ticket__cell--venue .ticket__strong {
      font-size: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(:root[data-intro='breaking']) .hero__content {
      transition: none;
    }
  }
</style>
